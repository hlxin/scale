{
  "nodes": [
    {
      "id": "ex:msyn/10.1098-rspa.1923.0036/characterization/water-soluble-products",
      "label": "Characterization",
      "props": {
        "name": "search for formaldehyde, methyl formate and methyl alcohol in the exit gas",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 5",
            "passage": "10.1098-rspa.1923.0036/p5/2",
            "quote": "A large volume of the gases emerging from the catalyst has been thoroughly scrubbed through a small quantity of water and the solution carefully examined.",
            "source": "ex:msyn/source/10.1098-rspa.1923.0036"
          },
          {
            "kind": "text",
            "locator": "p. 5",
            "passage": "10.1098-rspa.1923.0036/p5/2",
            "quote": "in no instance was the iodoform test responded to, as would have been the case in presence of traces of formal­dehyde",
            "source": "ex:msyn/source/10.1098-rspa.1923.0036"
          },
          {
            "kind": "text",
            "locator": "p. 5",
            "passage": "10.1098-rspa.1923.0036/p5/2",
            "quote": "careful fractionation through an 8-pear Young-Thomas column revealed no trace of any liquid boiling below 100° C. (methyl formate or methyl alcohol).",
            "source": "ex:msyn/source/10.1098-rspa.1923.0036"
          },
          {
            "kind": "text",
            "locator": "p. 5",
            "passage": "10.1098-rspa.1923.0036/p5/3",
            "quote": "it answers to tests characteristic of formic acid but not to those which would indicate formaldehyde or methyl alcohol.",
            "source": "ex:msyn/source/10.1098-rspa.1923.0036"
          }
        ],
        "experiment_kind": "physical",
        "note": "examination of the gases emerging from the nickel catalyst; the conclusion drawn is that no formaldehyde, methyl formate or methyl alcohol is present",
        "results": {
          "formaldehyde": {
            "status": "present",
            "as_reported": "in no instance was the iodoform test responded to",
            "text_value": "iodoform test not responded to"
          },
          "low_boiling_liquid": {
            "status": "present",
            "as_reported": "revealed no trace of any liquid boiling below 100° C. (methyl formate or methyl alcohol)",
            "text_value": "no liquid boiling below 100 °C (methyl formate or methyl alcohol)"
          },
          "reducing_action": {
            "status": "present",
            "as_reported": "The solution exerts some slight reducing action on ammoniacal silver nitrate and on mercuric chloride",
            "text_value": "slight reducing action on ammoniacal silver nitrate and mercuric chloride; answers to tests of formic acid"
          }
        },
        "technique": "exit gas scrubbed through water; iodoform test; fractionation through an 8-pear Young-Thomas column"
      }
    },
    {
      "id": "ex:msyn/10.1098-rspa.1923.0036/reaction/co-h2-to-co2-ch4",
      "label": "Reaction",
      "props": {
        "name": "2CO + 2H2 = CO2 + CH4",
        "description": "The action the authors report for equal volumes of CO and H2 over nickel below 300 °C.",
        "equation": "2 CO + 2 H2 -> CO2 + CH4",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 3",
            "passage": "10.1098-rspa.1923.0036/p3/3",
            "quote": "the only action being one which has apparently hitherto escaped observation, namely, 2CO+2H2 = C02+CH4.",
            "source": "ex:msyn/source/10.1098-rspa.1923.0036"
          }
        ]
      }
    },
