    {
      "id": "ex:msyn/10.1021-ja01339a003/claim/product-matches-methanol-equilibrium",
      "label": "Claim",
      "props": {
        "name": "Kp1 × Kp2 agrees with published methanol equilibrium constants",
        "claim_kind": "data_quality",
        "claim_status": "supported",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 12",
            "note": "quote withheld: sha256:be87c69ba30167d986415a6caf2b61edcc433ee6ecd552ad6cec904857a99b13 chars:113",
            "passage": "10.1021-ja01339a003/p12/1",
            "source": "ex:msyn/source/10.1021-ja01339a003"
          }
        ],
        "inference_type": "computational",
        "note": "the methanol synthesis constants (1 × 10^-3 to 5 × 10^-3) are cited from published work, not measured in this paper",
        "statement": "Kp1 × Kp2 at 250° calculated from equations (1) and (2) is 4 × 10^-3, within the range of published values of the methanol synthesis equilibrium constant (1 × 10^-3 to 5 × 10^-3), showing that the measured constants are of the correct order of magnitude."
      }
    },
