    {
      "id": "ex:msyn/10.1246-nikkashi1898.54.367/claim/eguchi-mechanism-doubtful",
      "label": "Claim",
      "props": {
        "name": "the formic-acid route of the synthesis mechanism is doubtful for decomposition over ZnO",
        "claim_kind": "mechanism",
        "claim_status": "proposed",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 3",
            "note": "quote withheld: sha256:44febb3fc52dd69136b21d0fe0b9d0a558a5b4bec82d69607296637550fab618 chars:144",
            "passage": "10.1246-nikkashi1898.54.367/p3/3",
            "source": "ex:msyn/source/10.1246-nikkashi1898.54.367"
          }
        ],
        "inference_type": "theoretical",
        "note": "the mechanisms discussed (Morgan et al.; Eguchi) and the dehydrogenation of formic acid over ZnO (Sabatier and Senderens) are cited from other work",
        "statement": "Whether water bound to ZnO accelerates HCHO decomposition by the same mechanism proposed for methanol synthesis (CO + H2O ⇌ HCOOH, etc.) is doubtful, because ZnO acts as a dehydrogenation catalyst toward formic acid, so the reverse of reaction (1) (HCOOH → CO + H2O) cannot occur."
      }
    },
    {
      "id": "ex:msyn/10.1246-nikkashi1898.54.367/hypothesis/water-monolayer-on-zno",
      "label": "Hypothesis",
      "props": {
        "name": "water bound as a monomolecular layer on the ZnO surface",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 3",
            "note": "quote withheld: sha256:60faba4ee7986a87878ca3dafe9db922d0d9a3d446c4ae1eb4f787f59e79331a chars:60",
            "passage": "10.1246-nikkashi1898.54.367/p3/2",
            "source": "ex:msyn/source/10.1246-nikkashi1898.54.367"
          }
        ],
        "hypothesis_kind": "auxiliary",
        "hypothesis_status": "proposed",
        "note": "working assumption; Boswell's NiO model is cited",
        "statement": "As in Boswell's model for NiO, water molecules are assumed to be bound or adsorbed on the ZnO surface as a monomolecular layer."
      }
    },
