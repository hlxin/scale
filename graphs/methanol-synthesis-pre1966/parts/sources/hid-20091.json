      "id": "ex:msyn/hid-20091/claim/stable-oxide-by-honjo-diagram",
      "label": "Claim",
      "props": {
        "name": "From Honjo's diagram (cited), Cu2O would be the stable oxide at about 900 °C in ",
        "claim_kind": "other",
        "claim_status": "proposed",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 104",
            "note": "quote withheld: sha256:fa3f872c115e0c35669319097f7a68073150e8497d4a249e30529fc646a5d4b6 chars:208",
            "passage": "hid-20091/p104/1",
            "source": "ex:msyn/source/hid-20091"
          }
        ],
        "inference_type": "theoretical",
        "note": "based on a diagram cited from Honjo (ref. 59); not measured on these catalysts",
        "statement": "From Honjo's diagram (cited), Cu2O would be the stable oxide at about 900 °C in the pressure range used (flame-quenched, furnace-quenched, electrically heated catalysts), and CuO under the low-temperature oxidation conditions (300 °C, 60 cm oxygen)."
      }
    },
    {
      "id": "ex:msyn/hid-20091/hypothesis/all-catalysts-p-type",
      "label": "Hypothesis",
      "props": {
        "name": "All the oxidised copper catalysts are p-type semiconductors, with more cation va",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 106",
            "note": "quote withheld: sha256:f33c21c26d8fdae72d16ed33d0772c19ecd02df9ddba218289f2570d7b99e3df chars:99",
            "passage": "hid-20091/p106/1",
            "source": "ex:msyn/source/hid-20091"
          }
        ],
        "hypothesis_kind": "auxiliary",
        "hypothesis_status": "proposed",
        "statement": "All the oxidised copper catalysts are p-type semiconductors, with more cation vacancies and Cu2+ ions the greater the pre-oxidation (supposition from conductivity work of Stone and Smith on oxidised copper films)."
      }
    },
    {
      "id": "ex:msyn/hid-20091/hypothesis/p-type-cu2o-defect-activity",
      "label": "Hypothesis",
      "props": {
        "name": "The activity of the oxidised copper catalysts is due to a p-type semiconducting ",
        "evidence": [
          {
            "kind": "text",
