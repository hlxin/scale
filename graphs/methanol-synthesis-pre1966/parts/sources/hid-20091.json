            "note": "quote withheld: sha256:6b904f738713636a40ad6a3cf23d5fdd675d77b828a9bf60a2600e21e23ef986 chars:152",
            "passage": "hid-20091/p110/1",
            "source": "ex:msyn/source/hid-20091"
          }
        ],
        "hypothesis_kind": "explanatory",
        "hypothesis_status": "proposed",
        "statement": "The activity of the oxidised copper catalysts is due to a p-type semiconducting cuprous oxide defect structure; this is contrary to the opinion that dehydrogenation is facilitated by n-type oxides."
      }
    },
