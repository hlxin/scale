    {
      "id": "ex:msyn/hid-20089/claim/iron-runaway-carbon",
      "label": "Claim",
      "props": {
        "name": "The iron catalyst, more than the cobalt catalyst, is subject to run-away reaction and to t",
        "claim_kind": "comparison",
        "claim_status": "supported",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 4",
            "note": "quote withheld: sha256:7a300128f8760296b2ae6bcd820a230a0fa19c0c9883c4b448494dd29bb5ab80 chars:147",
            "passage": "hid-20089/p4/1",
            "source": "ex:msyn/source/hid-20089"
          }
        ],
        "inference_type": "expert_opinion",
        "statement": "The iron catalyst, more than the cobalt catalyst, is subject to run-away reaction and to the formation of carbon on the catalyst, so special precautions are required."
      }
    },
    {
      "id": "ex:msyn/hid-20089/claim/iron-vs-cobalt-advantages",
