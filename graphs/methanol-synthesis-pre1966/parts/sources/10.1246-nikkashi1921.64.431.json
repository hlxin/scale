{
  "nodes": [
    {
      "id": "ex:msyn/10.1246-nikkashi1921.64.431/hypothesis/boiling-to-basic-carbonate",
      "label": "Hypothesis",
      "props": {
        "name": "bicarbonate and carbonate catalysts alike because normal carbonate turns into basic carbonate on boiling",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 5",
            "note": "quote withheld: sha256:e49b9937a168cb82779414e5f110e46a46108d35f94a87bfc5372be193e90a5e chars:123",
            "passage": "10.1246-nikkashi1921.64.431/p5/1",
            "source": "ex:msyn/source/10.1246-nikkashi1921.64.431"
          }
        ],
        "hypothesis_kind": "explanatory",
        "hypothesis_status": "proposed",
        "note": "that the normal carbonate readily turns into basic carbonate on boiling is cited from the literature (ref. 11); the precipitate compositions are given with literature references (refs. 9, 10)",
        "statement": "The near-equal activity of catalysts precipitated with alkali bicarbonates and carbonates can be interpreted as due to the normal carbonate being converted to basic carbonate by the boiling after precipitation, so that both have the same catalyst precursor form."
      }
    },
    {
      "id": "ex:msyn/10.1246-nikkashi1921.64.431/hypothesis/no-ammine-complex",
      "label": "Hypothesis",
      "props": {
        "name": "basic zinc carbonate does not form the ammine complex",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 7",
            "note": "quote withheld: sha256:408ae045204cfdbf488570673a68a916afbbf1342c91cfdd710254c2e0ba75ec chars:75",
            "passage": "10.1246-nikkashi1921.64.431/p7/1",
            "source": "ex:msyn/source/10.1246-nikkashi1921.64.431"
          }
        ],
        "hypothesis_kind": "explanatory",
        "hypothesis_status": "proposed",
        "note": "the author states there is not yet experimental ground to confirm it",
        "statement": "Probably, unlike zinc hydroxide, basic zinc carbonate does not form a complex ion such as [Zn(NH3)4]++ when dissolved in concentrated ammonia solution."
      }
    },
    {
      "id": "ex:msyn/10.1246-nikkashi1921.64.431/species/basic-zinc-carbonate",
      "label": "ChemicalSpecies",
      "props": {
        "name": "basic zinc carbonate (鹽基性炭酸鹽)",
        "evidence": [
          {
            "kind": "text",
            "locator": "p. 5",
            "note": "quote withheld: sha256:1b70e4f39d44d1a2b5c3f7084aed58a838b57a40945413c599cd37463cbfcfe2 chars:50",
            "passage": "10.1246-nikkashi1921.64.431/p5/1",
            "source": "ex:msyn/source/10.1246-nikkashi1921.64.431"
          }
        ],
        "formula": "ZnCO3.Zn(OH)2",
        "note": "the source gives the form ZnCO3.Zn(OH)2 and notes (footnote 10) that many basic carbonates are known"
      }
    },
