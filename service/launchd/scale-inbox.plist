<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The inbox runner: launchd starts it whenever the inbox's queue folder holds something (a publication the service
     queued, or a PDF dropped there by hand), and again while it does; the runner curates each one with Claude Code for
     its owner and empties the queue (scaleweb/runner.py). install.sh fills the @...@ paths. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>scale-catal.inbox</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>@CHECKOUT@/service/launchd/scale-web.sh</string>
    <string>runner</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SCALE_WEB_ENV</key>
    <string>@ENV@</string>
  </dict>
  <key>QueueDirectories</key>
  <array>
    <string>@INBOX@/queue</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>@LOGS@/runner.log</string>
  <key>StandardErrorPath</key>
  <string>@LOGS@/runner.log</string>
</dict>
</plist>
