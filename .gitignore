__pycache__/
*.egg-info/
.pytest_cache/
build/
dist/
.venv/
/venv/
/env/
uv.lock
demo-output/
*.pyc
.DS_Store

# local material of an example or corpus (source texts, OCR, scratch): never committed (layout.LOCAL_DIRS)
/domain/examples/**/work/
/domain/examples/**/scratchpad/
/examples/**/work/
/examples/**/scratchpad/

# example corpora: source PDFs stay local (size, copyright); each example lists them with their sha256
/examples/*/pdfs/
# an example's evidence index is rebuilt from its graph (scale graph index)
/examples/**/*.evidence.*

# the public-domain example commits its PDFs (public domain in the US)
!/examples/methanol-synthesis-public/pdfs/

# graphs/: no source PDFs or local material; built graphs and evidence indexes are rebuilt from the parts
/graphs/*/pdfs/
/graphs/**/work/
/graphs/**/scratchpad/
/graphs/**/*.graph.json
/graphs/**/*.evidence.*

# databases kept beside the catal commons literature tools are never committed
graphs/catal-commons/literature/*.db
graphs/catal-commons/literature/*.db.gz
_site/
